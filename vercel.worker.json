{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "deploy/worker-status",
  "daemons": {
    "echotrace-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "command": ["python", "-m", "app.worker"],
      "instances": { "sin1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 30
    }
  }
}
