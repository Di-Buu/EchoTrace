# Two distinct, confirmed, dedicated test accounts are required for the core
# product-risk suite. The runner deletes only these accounts' EchoTrace product
# data during test setup/cleanup; it does not delete their Auth users.
ECHOTRACE_EVAL_EMAIL=your-confirmed-test-account@example.com
ECHOTRACE_EVAL_PASSWORD=your-test-password
ECHOTRACE_EVAL_B_EMAIL=another-confirmed-test-account@example.com
ECHOTRACE_EVAL_B_PASSWORD=another-test-password

# Optional. Defaults to the local quality API.
ECHOTRACE_EVAL_API_URL=http://127.0.0.1:8000
